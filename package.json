    "@nestjs/core": "^11.1.24",
    "@nestjs/elasticsearch": "^11.1.0",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/platform-socket.io": "^11.1.24",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "@nestjs/websockets": "^11.1.24",
    "@scalar/nestjs-api-reference": "^0.5.14",
    "@socket.io/redis-adapter": "^8.3.0",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.40",
    "BullMQAdapter": "link:@bull-board/api/BullMQAdapter",
    "argon2": "^0.44.0",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.77.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cloudinary": "^2.10.0",
    "csrf-csrf": "^4.0.3",
    "dataloader": "^2.2.3",
    "express": "^4.22.2",
    "express-basic-auth": "^1.2.1",
    "express-session": "^1.19.0",
    "firebase-admin": "^13.10.0",
    "glob": "^10.5.0",
    "graphql": "^16.14.0",
    "graphql-type-json": "^0.3.2",
    "handlebars": "^4.7.9",
    "helmet": "^8.2.0",
    "husky": "^9.1.7",
    "ioredis": "^5.10.1",
    "lodash": "^4.18.1",
    "multer": "^2.1.1",
    "nest-winston": "^1.10.2",
    "nestjs-redis-client": "^1.0.12",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.21.0",
    "pm2": "^6.0.14",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.30",
    "uuid": "^13.0.2",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.24",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.21",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.24",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.19.19",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "oxlint": "^1.68.0",
    "prettier": "^3.8.3",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/unit/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1",
      "^uuid$": "<rootDir>/test/mocks/uuid.ts"
    }
  }
}
