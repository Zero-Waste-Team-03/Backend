{
  "name": "Gazp Zero",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:pm2": "pm2 start ecosystem.config.js --env production",
    "migration:generate": "pnpm dlx tsx ./node_modules/typeorm/cli.js migration:generate -d ./src/infrastructure/db/data-source.ts",
    "migration:run": "pnpm dlx tsx ./node_modules/typeorm/cli.js migration:run -d ./src/infrastructure/db/data-source.ts",
    "migration:revert": "pnpm dlx tsx ./node_modules/typeorm/cli.js migration:revert -d ./src/infrastructure/db/data-source.ts",
    "seed:users": "pnpm dlx tsx ./src/common/scripts/seed/seed-users.ts",
    "seed:categories": "pnpm dlx tsx ./src/common/scripts/seed/seed-categories.ts",
    "seed:attachments": "pnpm dlx tsx ./src/common/scripts/seed/seed-attachments.ts",
    "seed:donations": "pnpm dlx tsx ./src/common/scripts/seed/seed-donations.ts",
    "seed:leaderboard": "pnpm dlx tsx ./src/common/scripts/seed/seed-reputation-logs.ts",
    "seed:badges": "pnpm dlx tsx ./src/common/scripts/seed/seed-badges.ts",
    "seed:achievements": "pnpm dlx tsx ./src/common/scripts/seed/seed-achievements.ts",
    "seed:reservations": "pnpm dlx tsx ./src/common/scripts/seed/seed-reservations.ts",
    "seed:conversations": "pnpm dlx tsx ./src/common/scripts/seed/seed-conversations.ts",
    "seed:reports": "pnpm dlx tsx ./src/common/scripts/seed/seed-reports.ts",
    "seed:tokens": "pnpm dlx tsx ./src/common/scripts/seed/seed-tokens.ts",
    "seed:notifications": "pnpm dlx tsx ./src/common/scripts/seed/seed-notifications.ts",
    "seed:demo": "PEXELS_API_KEY=${PEXELS_API_KEY} pnpm dlx tsx ./src/common/scripts/seed/seed-demo.ts",
    "seed:all": "pnpm seed:users && pnpm seed:categories && pnpm seed:attachments && pnpm seed:badges && pnpm seed:donations && pnpm seed:reservations && pnpm seed:conversations && pnpm seed:reports && pnpm seed:achievements && pnpm seed:tokens && pnpm seed:notifications && pnpm sync-leaderboard",
    "sync-leaderboard": "pnpm dlx tsx ./src/common/scripts/sync-leaderboard.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:all": "pnpm test && pnpm test:e2e",
    "prepare": "husky",
    "env:sync": "bash ./load_env_to_secrets.sh"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@bull-board/api": "^6.21.3",
    "@bull-board/express": "^6.21.3",
    "@bull-board/nestjs": "^6.21.3",
    "@css-inline/css-inline": "^0.14.3",
    "@nestjs-modules/mailer": "^2.3.6",
    "@nestjs/apollo": "^13.4.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
